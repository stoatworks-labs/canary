.venv/
.venv-cad/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
# ESP-IDF
firmware/build/
# The bench self-test image is built into its own tree so the product build
# is never silently replaced by it: idf.py build -DDBCANARY_SELFTEST=1
firmware/build-selftest/
# QEMU boots a UART-console variant (its console sink differs from the
# shipping USB-Serial-JTAG one, which -nographic cannot capture), and the
# J301 fallback console image is built the same way. Both carry their own
# sdkconfig so they never disturb the product one.
firmware/build-qemu/
firmware/build-qemu-usbnet/
firmware/build-selftest-uart/
# The USB-NCM image (sdkconfig.usb-ncm) carries its own sdkconfig too.
firmware/build-usbnet/
firmware/sdkconfig
firmware/sdkconfig.old

# Fetched by the IDF component manager from components.espressif.com (esp_tinyusb,
# for components/usbnet). Generated, and re-fetched on demand; `dependencies.lock`
# IS committed, so a build resolves to the same versions every time.
firmware/managed_components/

# Vendor manuals — kept locally for reference, not redistributed.
# See docs/SOURCES.md for where to get them.
docs/*.pdf
sdkconfig.old

# KiCad
*.kicad_prl
*-backups/
fp-info-cache

# KiCad lock / history artifacts
~*.lck
.history/

# Plugin / tool scratch output
# Konnect MCP per-project cache
hardware/.konnect/
# JLC Fabrication Toolkit scratch output (we move it into fab/)
hardware/production/
*.bak
hardware/fab/**/backups/

# kicad-jlcpcb-tools writes here when run from the KiCad GUI.
# Our packages are built by the vendor toolkits into hardware/fab/,
# so this is duplicate output that goes stale silently.
hardware/jlcpcb/
# Vendor datasheets belong here locally but are NOT redistributed -
# same policy as docs/*.pdf. See docs/SOURCES.md.
hardware/lib/*.pdf

# KiCad fabrication outputs: the vendor packages under hardware/**/fab/ are the
# deliverable and ARE tracked, archives included. Only the loose expansion of
# the generic gerber zip is ignored - it is that archive, unpacked.
hardware/**/fab/generic/gerbers/

# hostsim: host build of the firmware, and fuzzing artefacts
firmware/hostsim/dbcanaryd
firmware/hostsim/*.dSYM/

# vendor toolkit scratch output (like hardware/production/)
hardware/fab/pcbway-toolkit/

# Enclosure slicing scratch: presets are flattened from the Studio system tree and
# project_settings.json is derived from a reference 3mf outside the repo, so both are
# regenerated by hardware/enclosure/bambu/build.sh. The plate 3mf IS the deliverable.
hardware/enclosure/bambu/work/
hardware/enclosure/bambu/presets/
hardware/enclosure/bambu/project_settings.json
hardware/enclosure/bambu/result.json
